# Variables para el docker-compose.yml de la RAÍZ (orquesta front+back+BD
# juntos). Docker Compose solo lee automáticamente el `.env` que está en
# el mismo directorio desde donde corres `docker compose` (esta raíz) —
# por eso POSTGRES_USER/PASSWORD/DB deben repetirse aquí para que el
# propio archivo docker-compose.yml los pueda interpolar, AUNQUE el
# contenedor del backend además lea `backend/.env` completo vía
# `env_file`. Deben coincidir con los mismos valores en backend/.env
# (JWT_SECRET y el resto de variables del backend NO se duplican aquí).
#
# Copia este archivo a `.env` (mismo nivel) y ajusta los valores reales.

POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=indi_combustible

# URL pública donde quedará expuesto el backend — el frontend se compila
# apuntando a esta URL (ver frontend/lib/config/api_config.dart y
# frontend/Dockerfile). Ejemplos:
#   http://IP_DEL_SERVIDOR:3000        (sin dominio/HTTPS todavía)
#   https://api.midominio.com          (con dominio y proxy/TLS por fuera)
PUBLIC_API_BASE_URL=http://localhost:3000
