DATABASE_URL=postgresql://usuario:password@localhost:5432/indi_combustible
# Contra AWS RDS, la cadena luce así (host termina en .rds.amazonaws.com):
# DATABASE_URL=postgresql://usuario:password@indi-db.xxxxx.us-east-1.rds.amazonaws.com:5432/indi_combustible
# DATABASE_SSL=true

# ── CA para TLS PostgreSQL ───────────────────────────────────────
# Si DATABASE_SSL=true en producción, necesitas una CA para validar
# el certificado del servidor. Acepta cualquiera de las dos:
#
# DATABASE_CA_CERT — PEM inline (multilínea con \n o saltos reales).
#   Ejemplo: DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
#
# DATABASE_CA_CERT_PATH — ruta a archivo PEM en disco.
#   Ejemplo: DATABASE_CA_CERT_PATH=/etc/ssl/certs/rds-combined-ca-bundle.pem
#
# Si ambas están definidas, DATABASE_CA_CERT tiene precedencia.
# En desarrollo local con PostgreSQL Docker, no son necesarias.
# DATABASE_CA_CERT=
# DATABASE_CA_CERT_PATH=

# Solo hacen falta si usas `docker-compose.yml` (Postgres en un
# contenedor local/VPS propio, no RDS/PaaS) — deben coincidir con el
# usuario/password/db de la `DATABASE_URL` de arriba. `docker-compose.yml`
# las lee de aquí en vez de tenerlas hardcodeadas (nunca subas este
# archivo con valores reales, solo `.env.example`).
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=indi_combustible

# Habilita TLS en la conexión a Postgres (ver src/db/pool.ts). RDS lo
# exige por defecto en la mayoría de parameter groups — en local (Docker)
# se deja apagado.
DATABASE_SSL=false
PORT=3000
JWT_SECRET=cambia_esto
JWT_EXPIRES_IN=7d
# Vigencia del access token (JWT). Nombre nuevo — si no está definido cae
# a JWT_EXPIRES_IN (compatibilidad) y si tampoco, a 15m. El refresh token
# (ver POST /auth/refresh) es el que ahora cubre sesiones largas.
ACCESS_TOKEN_EXPIRES_IN=15m
# Vigencia del refresh token, en días (ver src/services/refreshTokenService.ts).
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
NODE_ENV=development
# Carpeta donde `multer` guarda las fotos (tablero/ticket/evidencias) en
# disco local — ver src/middleware/upload.ts. En un contenedor de AWS
# (App Runner/ECS/EC2 sin volumen persistente) esta carpeta se pierde en
# cada redeploy/restart: para producción real hace falta moverla a S3 o
# montar un volumen persistente (EBS/EFS). No forma parte de esta
# migración a RDS — es un pendiente aparte.
UPLOADS_DIR=uploads
PRESUPUESTO_SEMANAL_TOTAL=50000

# Origin permitido para CORS (separa varios con coma si hace falta,
# ej. "http://localhost:5173,https://app.indi.com"). Si no se define,
# se permite cualquier origin (solo pensado para desarrollo local).
CORS_ORIGIN=http://localhost:*

# Nivel de log de pino (trace|debug|info|warn|error|fatal). Por default
# cae a "debug" en desarrollo y "info" en producción.
LOG_LEVEL=debug

# Rate limiting de rutas de auth (ver src/middleware/rateLimit.ts).
# Ventana en milisegundos y máximo de intentos por IP dentro de ella.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX_NORMAL=20

# Recuperación de contraseña. PASSWORD_RESET_PUBLIC_URL puede ser un deep
# link móvil o la URL Web pública de /restablecer-password.
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_PUBLIC_URL=http://localhost:8080/restablecer-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASSWORD=cambiar
SMTP_FROM=INDI Combustible <no-reply@example.com>
