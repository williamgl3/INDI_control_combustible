{
  "name": "indi_control_combustible",
  "version": "1.0.0",
  "description": "Sistema de Control y Autorización de Combustible para  Vehículos en Obra \"Grupo INDI\"",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "audit:idempotency": "ts-node src/db/auditarIdempotenciaSolicitudes.ts",
    "test:idempotency:db": "ts-node src/db/probarConcurrenciaSolicitudes.ts",
    "seed": "ts-node src/db/seed.ts",
    "seed:superadmin": "ts-node src/db/seedSuperadmin.ts",
    "importar:vehiculos": "ts-node src/db/importarVehiculos.ts",
    "db:up": "docker compose up -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamgl3/INDI_control_combustible.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/williamgl3/INDI_control_combustible/issues"
  },
  "homepage": "https://github.com/williamgl3/INDI_control_combustible#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
